PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/equipment_db
JWT_SECRET=your_super_secret_jwt_key_change_in_production
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# OPTIONAL: Protected system accounts (one-time migration only)
# Only needed when running: npm run mark-protected-users
# Not required for normal application runtime after migration
# PROTECTED_ADMIN_EMAIL=admin@example.com
# PROTECTED_TECHNICIAN_EMAIL=technician@example.com
# PROTECTED_VIEWER_EMAIL=viewer@example.com

# OPTIONAL: Demo machine protection (one-time migration only)
# Only needed when running: npm run mark-demo-machines
# Set to the exact MongoDB _id values of machines to be protected
# All three IDs must be valid ObjectIds and must exist in the database
# Not required for normal application runtime after migration
# DEMO_MACHINE_ID_1=
# DEMO_MACHINE_ID_2=
# DEMO_MACHINE_ID_3=
